  "businessCellDefinition": {
    "purpose": "Smallest auditable business-operating unit that owns an outcome, SLA, controls and measurable KPIs.",
    "required": [
      "id",
      "name",
      "domainId",
      "capabilityIds",
      "roles",
      "inputs",
      "outputs",
      "controls",
      "events",
      "kpis",
      "sla",
      "evidence"
    ]
  },
  "rules": [
    "Every production module must map to exactly one canonical owning domain and may reference other domains.",
    "Every API/service/worker must map to a capability and business cell or be explicitly classified as platform infrastructure.",
    "UI pages cannot be the sole representation of a capability.",
    "A dashboard without underlying workflow/state/control implementation is not a completed capability.",
    "Aliases preserve historical naming but never create duplicate canonical ownership.",
    "Domain taxonomy is additive during reconciliation; destructive reclassification requires evidence and migration mapping."
  ]
}
