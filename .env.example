# =============================================================================
# AFRERA Platform - Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values. Never commit secrets to git.
# For production, use your deployment platform's secret manager instead.

# ==================== NODE ENVIRONMENT ====================
NODE_ENV=development

# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL
DB_USER=afrera_user
DB_PASSWORD=CHANGE_ME_secure_postgres_password
DB_NAME=afrera_prod

# MongoDB
MONGODB_PASSWORD=CHANGE_ME_secure_mongo_password

# Redis
REDIS_PASSWORD=CHANGE_ME_secure_redis_password

# RabbitMQ
RABBITMQ_PASSWORD=CHANGE_ME_secure_rabbitmq_password

# ==================== SECURITY & TOKENS ====================
JWT_SECRET=CHANGE_ME_use_a_long_random_value_min_32_chars
ENCRYPTION_KEY=CHANGE_ME_use_a_long_random_value_min_32_chars

# ==================== APPLICATION PORTS ====================
# Frontend runs on port 5173 (mapped from internal 80)
# Backend API runs on port 3001 (mapped from internal 3000)
# PostgreSQL runs on 5432
# MongoDB runs on 27017
# Redis runs on 6379
# RabbitMQ API runs on 5672, Management runs on 15672
# Elasticsearch runs on 9200

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== OPTIONAL: AI SERVICES ====================
# Uncomment and configure if using AI features
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ==================== OPTIONAL: ERP INTEGRATIONS ====================
# Uncomment and configure if using ERP features
# SAP_ENABLED=false
# SAP_HOST=
# SAP_PORT=
# SAP_CLIENT=
# SAP_USER=
# SAP_PASSWORD=
# SAP_SYSTEM_ID=

# ORACLE_ENABLED=false
# ORACLE_HOST=
# ORACLE_PORT=
# ORACLE_SERVICE=
# ORACLE_USER=
# ORACLE_PASSWORD=

# ==================== OPTIONAL: THIRD-PARTY SERVICES ====================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=
